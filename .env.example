# Environment Configuration for SPORTSPOT

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local development or containerized postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportspot?schema=public"

# Authentication & Sessions
SESSION_SECRET="sportspot_super_secure_session_secret_change_in_production_key_32chars"
JWT_SECRET="sportspot_jwt_token_secret_key_change_in_production_998877"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# Socket.IO
SOCKET_CORS_ORIGIN="http://localhost:5173"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# External Integration Flags (Clearly identified as unconfigured/mocked until credentials provided)
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@sportspot.io"

DOCUSIGN_CLIENT_ID=""
DOCUSIGN_SECRET=""
